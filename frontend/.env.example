# Landing-page-only mode. The waitlist invokes the Supabase Edge Function, so
# the browser only needs the public project URL and anon key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The Obligo API's origin — this is the switch between demo mode and the real
# backend, not merely a hostname.
#
#   UNSET  Demo mode. No request is ever made, Settings/Profile/Telegram run on
#          shipped defaults for the session, and a 401 can't bounce you out of
#          the workspace. This is how the app behaved before the backend
#          existed, and it stays useful for frontend-only work.
#   SET    Real mode. The three stores hydrate from the API on shell mount,
#          write through on change, and an expired session redirects to
#          Landing.
#
# Local backend: http://localhost:4000
# Must exactly match the backend's own FRONTEND_URL/CORS expectations in
# production, since these requests carry cookies.
VITE_API_BASE=
