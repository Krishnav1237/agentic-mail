# Obligo — Backend Environment Variables
# Copy this file to .env and fill in your values.
# DO NOT commit .env with real secrets.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/obligo

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Authentication ───────────────────────────────────────────────────────────
# Must be at least 32 characters — use a cryptographically random value in production
# Example: openssl rand -hex 32
AUTH_JWT_SECRET=replace-with-minimum-32-character-secret-in-production

AUTH_JWT_ISSUER=obligo-api
AUTH_JWT_AUDIENCE=obligo-app

# AES-256-GCM token encryption key — must be a base64 string encoding exactly 32 bytes
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# ─── AI Provider (choose one) ─────────────────────────────────────────────────
# AI_PROVIDER must be: gemini | openrouter | groq | disabled
AI_PROVIDER=gemini
# Gemini model IDs change over time. Prefer a currently supported generateContent model
# (e.g. gemini-flash-latest). gemini-1.5-flash / gemini-2.5-flash may return 404 for new keys.
AI_MODEL=gemini-flash-latest
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Enable deterministic fallback analysis when no API key is configured.
# MUST be false in production (fails closed when key is missing).
# Set to true only in development/test.
AI_FALLBACK_ENABLED=true

# Maximum email body characters sent to AI model (1–50000)
AI_MAX_INPUT_CHARS=6000

# AI provider request timeout in milliseconds (1000–120000)
AI_REQUEST_TIMEOUT_MS=30000

# ─── Sync Settings ────────────────────────────────────────────────────────────
# Maximum messages imported during initial Gmail sync (1–5000)
INITIAL_SYNC_MAX_MESSAGES=500

# ─── Validation infrastructure ────────────────────────────────────────────────
# Pre-shared secret for internal /validation/* API endpoints.
# Leave empty to disable all validation endpoints.
# Must be at least 32 characters in production.
# NEVER log this value. NEVER expose it in API responses.
# Generate: openssl rand -hex 32
VALIDATION_TOKEN=

# Controls email noise scoring behaviour.
# off    — scoring disabled entirely (default)
# shadow — score is computed and stored but does NOT affect extraction pipeline
# active — affects queue priority (NOT yet enabled in production)
EMAIL_SCORING_MODE=off
